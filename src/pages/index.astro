---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import MapSection from "../components/MapSection.astro";
import "../styles/global.css";
import ServicesSection from "../components/ServicesSection.astro";
import SliderSection from "../components/SliderSection.astro";
import { getPagePath } from "../utils/paths";
---
<Layout>
  <section class="bg-gradient-to-br from-blue-50 to-blue-100 py-20 text-center fade-in-up">
    <h1 class="text-6xl font-extrabold text-blue-700 mb-6 animate-bounce-in">Laboratorio Clínico Rosario Arnedo Pombo</h1>
    <p class="text-2xl text-gray-700 mb-4 font-semibold animate-fade-in-up" style="animation-delay: 0.2s">Más de 25 años evolucionando la salud de nuestra comunidad</p>
    <p class="text-lg text-gray-500 mb-8 animate-fade-in-up" style="animation-delay: 0.3s">Diagnósticos confiables, atención personalizada y tecnología de vanguardia.</p>
    <a href={getPagePath("/contacto")} class="inline-block px-10 py-4 bg-blue-700 text-white rounded-full shadow-lg hover:bg-blue-800 transition animate-pulse-glow" style="animation-delay: 0.4s">Solicita tu examen</a>
  </section>

  <section class="py-16 bg-white fade-in-up">
    <h2 class="text-4xl font-bold text-blue-700 text-center mb-10">¿Por qué elegirnos?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      <div class="bg-blue-50 rounded-xl p-8 shadow flex flex-col items-center fade-in-up hover-lift hover-glow stagger-item">
        <svg class="w-12 h-12 text-blue-600 mb-4 animate-floating" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <h3 class="text-xl font-bold mb-2">Resultados confiables</h3>
        <p class="text-gray-600">Tecnología avanzada y personal calificado para diagnósticos precisos.</p>
      </div>
      <div class="bg-blue-50 rounded-xl p-8 shadow flex flex-col items-center fade-in-up hover-lift hover-glow stagger-item">
        <svg class="w-12 h-12 text-blue-600 mb-4 animate-floating" style="animation-delay: 0.3s" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6"></path></svg>
        <h3 class="text-xl font-bold mb-2">Atención personalizada</h3>
        <p class="text-gray-600">Nos adaptamos a tus necesidades y te acompañamos en cada paso.</p>
      </div>
      <div class="bg-blue-50 rounded-xl p-8 shadow flex flex-col items-center fade-in-up hover-lift hover-glow stagger-item">
        <svg class="w-12 h-12 text-blue-600 mb-4 animate-floating" style="animation-delay: 0.6s" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"></path></svg>
        <h3 class="text-xl font-bold mb-2">Garantía y soporte</h3>
        <p class="text-gray-600">Acompañamiento post-servicio y garantía de satisfacción.</p>
      </div>
    </div>
  </section>

  <div class="fade-in-up">
    <SliderSection />
  </div>
  <div class="fade-in-up">
    <ServicesSection />
  </div>
  <div class="fade-in-up">
    <MapSection />
  </div>

  <script>
    // Animación de aparición con scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in-up');
        }
      });
    }, { threshold: 0.2 });
    document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));
  </script>
  <style>
    .fade-in-up {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.8s cubic-bezier(.4,0,.2,1), transform 0.8s cubic-bezier(.4,0,.2,1);
    }
    .animate-fade-in-up {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }
  </style>
</Layout>
