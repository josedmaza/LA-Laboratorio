---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { getPagePath } from "../utils/paths";
---

<Layout>
  <main class="container mx-auto px-4 py-16">
    <section class="flex flex-col items-center mb-16">
      <h1 class="text-5xl font-extrabold text-blue-700 mb-6">Quiénes Somos</h1>
      <h2 class="text-2xl font-bold text-blue-400 mb-4">
        Más de 25 años de experiencia en el sector salud
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 w-full max-w-4xl">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 fade-in-up hover-lift hover-glow stagger-item">
          <h3 class="text-xl font-bold text-blue-600 mb-2">
            Calidad y Confiabilidad
          </h3>
          <p class="text-gray-600">
            Reconocidos por la calidad y confiabilidad de los resultados, contamos
            con un talento humano cualificado, distinguido por ofrecer un servicio
            humanizado.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 fade-in-up hover-lift hover-glow stagger-item">
          <h3 class="text-xl font-bold text-blue-600 mb-2">
            Normativas y Servicio
          </h3>
          <p class="text-gray-600">
            Realizamos exámenes de baja y mediana complejidad, cumpliendo con las
            normativas de salud exigidas por las autoridades, garantizando la
            confiabilidad de los resultados en todas nuestras áreas.
          </p>
        </div>
      </div>
    </section>
    <section class="grid grid-cols-1 md:grid-cols-2 gap-10 w-full max-w-4xl mx-auto">
      <div class="bg-blue-50 rounded-2xl shadow-xl p-8 fade-in-up hover-lift hover-glow stagger-item">
        <h2 class="text-2xl font-bold text-blue-700 mb-4">Misión</h2>
        <p class="text-gray-700">
          Proveer servicios a pacientes y empresas a través de un Sistema de
          Gestión de Calidad eficaz y eficiente, para el diagnóstico en las áreas
          de hematología, coagulación, inmunología, inmunoanálisis, química
          clínica, uroanálisis y parasitología, contando con un talento humano
          competente y comprometido con el bienestar y salud del paciente.
        </p>
      </div>
      <div class="bg-blue-50 rounded-2xl shadow-xl p-8 fade-in-up hover-lift hover-glow stagger-item">
        <h2 class="text-2xl font-bold text-blue-700 mb-4">Visión</h2>
        <p class="text-gray-700">
          Para el año 2028, el Laboratorio Clínico Rosario Arnedo Pombo S.A.S
          proyecta ampliar la prestación del servicio a través de la apertura de
          nuevos puntos de toma de muestra, permitiendo mayor accesibilidad a la
          población.
        </p>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Animación de aparición con scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("animate-fade-in-up");
      }
    });
  },
  { threshold: 0.2 });
  document
    .querySelectorAll(".fade-in-up")
    .forEach((el) => observer.observe(el));
</script>

<style>
  .fade-in-up {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(.4, 0, .2, 1),
      transform 0.8s cubic-bezier(.4, 0, .2, 1);
  }
  .animate-fade-in-up {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
  
  .hover-lift {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hover-lift:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
  }
  
  .hover-glow {
    transition: box-shadow 0.3s ease;
  }
  .hover-glow:hover {
    box-shadow: 0 0 20px rgba(37, 99, 235, 0.3);
  }
  
  .stagger-item {
    --stagger-index: 0;
  }
  .stagger-item:nth-child(1) { animation-delay: 0.1s; }
  .stagger-item:nth-child(2) { animation-delay: 0.2s; }
  .stagger-item:nth-child(3) { animation-delay: 0.3s; }
  .stagger-item:nth-child(4) { animation-delay: 0.4s; }
</style>
