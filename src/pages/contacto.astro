---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import MapIcon from "../icons/Map.astro";
import ClockIcon from "../icons/Clock.astro";
import Mail from "../icons/Mail.astro";
import CellPhone from "../icons/CellPhone.astro";

// EmailJS configuration
const EMAILJS_PUBLIC_KEY = "tu_public_key_aqui"; // Reemplaza con tu Public Key de EmailJS
const EMAILJS_SERVICE_ID = "tu_service_id_aqui"; // Reemplaza con tu Service ID
const EMAILJS_TEMPLATE_ID = "tu_template_id_aqui"; // Reemplaza con tu Template ID
const RECIPIENT_EMAIL = "rosarioarnedolab@yahoo.es"; // El correo que recibirá los mensajes
---

<Layout>
  <section class="bg-gradient-to-br from-blue-50 to-blue-100 py-20">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="bg-white rounded-2xl shadow-xl p-10 border border-gray-100">
        <h2 class="text-4xl font-bold text-blue-700 mb-8">Contáctanos</h2>
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <MapIcon class="w-8 h-8 text-blue-600" />
            <div>
              <h4 class="text-lg font-semibold">Ubicación</h4>
              <p class="text-gray-700">Cartagena: Centro Médico Santa Lucía, piso 5, local 505</p>
              <p class="text-gray-700">Turbaco: Calle Las Flores #15-25</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <ClockIcon class="w-8 h-8 text-blue-600" />
            <div>
              <h4 class="text-lg font-semibold">Horario</h4>
              <p class="text-gray-700">Lun - Vie: 7am a 12pm - 1 30 pm a 4pm</p>
              <p class="text-gray-700">Sáb : 7am a 12pm</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <CellPhone class="w-8 h-8 text-blue-600" />
            <div>
              <h4 class="text-lg font-semibold">Llámanos</h4>
              <p class="text-gray-700">+57 3165264526</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <Mail class="w-8 h-8 text-blue-600" />
            <div>
              <h4 class="text-lg font-semibold">Correo</h4>
              <p class="text-gray-700 break-all">rosarioarnedolab@yahoo.es</p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-2xl shadow-xl p-10 border border-gray-100">
        <h2 class="text-4xl font-bold text-blue-700 mb-8">Envíanos un mensaje</h2>
        <form class="flex flex-col gap-6" id="contactForm">
          <input class="border rounded-xl border-gray-300 p-4 font-medium focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="Nombre" type="text" id="name" name="name" required />
          <input class="border rounded-xl border-gray-300 p-4 font-medium focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="Correo" type="email" id="email" name="email" required />
          <textarea class="border rounded-xl border-gray-300 p-4 font-medium focus:outline-none focus:ring-2 focus:ring-blue-400" rows="5" maxlength="500" placeholder="Mensaje" id="message" name="message" required></textarea>
          <button class="bg-blue-700 hover:bg-blue-800 text-white font-semibold py-3 px-8 rounded-full transition-all duration-300 shadow-lg" type="submit" id="submitBtn">Enviar</button>
          <div id="responseMessage" class="text-center font-semibold hidden"></div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ EMAILJS_PUBLIC_KEY, EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, RECIPIENT_EMAIL }}>
  // Cargar EmailJS
  (function() {
    emailjs.init(EMAILJS_PUBLIC_KEY);
  })();

  // Manejar el envío del formulario
  document.getElementById('contactForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = document.getElementById('submitBtn');
    const responseMessage = document.getElementById('responseMessage');
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    responseMessage.classList.add('hidden');

    try {
      const result = await emailjs.send(
        EMAILJS_SERVICE_ID,
        EMAILJS_TEMPLATE_ID,
        {
          to_email: RECIPIENT_EMAIL,
          from_name: document.getElementById('name').value,
          from_email: document.getElementById('email').value,
          message: document.getElementById('message').value
        }
      );

      responseMessage.classList.remove('hidden');
      responseMessage.classList.add('text-green-600');
      responseMessage.textContent = '✓ Mensaje enviado correctamente. Te contactaremos pronto.';
      
      document.getElementById('contactForm').reset();
      submitBtn.textContent = 'Enviar';
      
    } catch (error) {
      console.error('Error:', error);
      responseMessage.classList.remove('hidden');
      responseMessage.classList.add('text-red-600');
      responseMessage.textContent = '✗ Error al enviar. Intenta de nuevo.';
      submitBtn.textContent = 'Enviar';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
