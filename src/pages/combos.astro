---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const baseUrl = import.meta.env.BASE_URL;
---

<Layout>
  <main class="container mx-auto px-4 py-8">
    <section class="flex flex-col items-center justify-center mt-20">
      <div class="mb-12 text-center fade-in-up">
        <h1 class="text-5xl font-extrabold text-blue-600 mb-4">
          Combos Preventivos
        </h1>
        <p class="text-xl text-gray-700 mb-2 font-semibold">
          ¡Cuida tu salud y ahorra hasta el 35% con nuestros exclusivos combos!
        </p>
        <p class="text-lg text-gray-500">
          Haz de la prevención una prioridad y da el primer paso hacia una vida
          más saludable.
        </p>
        <a
        href="https://wa.me/573165264526?text=Hola%20%F0%9F%91%8B%20Me%20interesa%20conocer%20m%C3%A1s%20sobre%20sus%20combos%20preventivos"
        target="_blank"
        class="inline-block mt-6 px-8 py-3 bg-blue-700 text-white rounded-full shadow-lg hover:bg-blue-800 transition"
        >
          Contáctanos
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 w-full">
        {/* Tarjeta 1 */}
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center p-6 hover:scale-105 transition fade-in-up hover-lift hover-glow stagger-item">
          <img
            class="rounded-xl w-full h-56 object-cover mb-4"
            src={`${import.meta.env.BASE_URL}img/foto8.jpg`}
            alt="Salud general"
          />
          <h2 class="text-2xl font-bold text-blue-600 mb-2">
            Salud general
          </h2>
          <p class="text-gray-600 mb-4">
            Chequeo completo para tu bienestar. Incluye hemograma, glucosa,
            colesterol y más.
          </p>
          <a
            href="https://wa.me/573165264526?text=Me%20interesa%20el%20combo%20de%20Salud%20general%20%F0%9F%A7%AC"
            target="_blank"
            class="px-6 py-2 bg-blue-700 text-white rounded-full font-semibold shadow hover:bg-blue-800 transition animate-pulse-glow"
          >
            Solicitar combo
          </a>
        </div>
        {/* Tarjeta 2 */}
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center p-6 hover:scale-105 transition fade-in-up hover-lift hover-glow stagger-item">
          <img
            class="rounded-xl w-full h-56 object-cover mb-4"
            src={`${import.meta.env.BASE_URL}img/foto5.jpg`}
            alt="Preventivo infantil"
          />
          <h2 class="text-2xl font-bold text-blue-600 mb-2">
            Preventivo infantil
          </h2>
          <p class="text-gray-600 mb-4">
            Exámenes esenciales para niños. Incluye hemograma, orina, y pruebas de
            crecimiento.
          </p>
          <a
            href="https://wa.me/573165264526?text=Me%20interesa%20el%20combo%20de%20Preventivo%20infantil%20%F0%9F%92%AA"
            target="_blank"
            class="px-6 py-2 bg-blue-700 text-white rounded-full font-semibold shadow hover:bg-blue-800 transition animate-pulse-glow"
          >
            Solicitar combo
          </a>
        </div>
        {/* Tarjeta 3 */}
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center p-6 hover:scale-105 transition fade-in-up hover-lift hover-glow stagger-item">
          <img
            class="rounded-xl w-full h-56 object-cover mb-4"
            src={`${import.meta.env.BASE_URL}img/foto10.jpg`}
            alt="Perfil hepático"
          />
          <h2 class="text-2xl font-bold text-blue-600 mb-2">
            Perfil hepático
          </h2>
          <p class="text-gray-600 mb-4">
            Evalúa la salud de tu hígado con pruebas especializadas y confiables.
          </p>
          <a
            href="https://wa.me/573165264526?text=Me%20interesa%20el%20combo%20de%20Perfil%20hep%C3%A1tico%20%F0%9F%A6%B4"
            target="_blank"
            class="px-6 py-2 bg-blue-700 text-white rounded-full font-semibold shadow hover:bg-blue-800 transition"
          >
            Solicitar combo
          </a>
        </div>
        {/* Tarjeta 4 */}
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center p-6 hover:scale-105 transition fade-in-up">
          <img
            class="rounded-xl w-full h-56 object-cover mb-4"
            src={`${import.meta.env.BASE_URL}img/foto11.jpg`}
            alt="Perfil masculino Plus"
          />
          <h2 class="text-2xl font-bold text-blue-600 mb-2">
            Perfil masculino Plus
          </h2>
          <p class="text-gray-600 mb-4">
            Chequeo integral para hombres. Incluye PSA, testosterona y más.
          </p>
          <a
            href="https://wa.me/573165264526?text=Me%20interesa%20el%20combo%20de%20Perfil%20masculino%20Plus%20%F0%9F%92%AA"
            target="_blank"
            class="px-6 py-2 bg-blue-700 text-white rounded-full font-semibold shadow hover:bg-blue-800 transition"
          >
            Solicitar combo
          </a>
        </div>
        {/* Tarjeta 5 */}
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center p-6 hover:scale-105 transition fade-in-up">
          <img
            class="rounded-xl w-full h-56 object-cover mb-4"
            src={`${import.meta.env.BASE_URL}img/foto12.jpg`}
            alt="Perfil Renal"
          />
          <h2 class="text-2xl font-bold text-blue-600 mb-2">Perfil Renal</h2>
          <p class="text-gray-600 mb-4">
            Controla la función de tus riñones con exámenes especializados.
          </p>
          <a
            href="https://wa.me/573165264526?text=Me%20interesa%20el%20combo%20de%20Perfil%20Renal%20%F0%9F%AB%80"
            target="_blank"
            class="px-6 py-2 bg-blue-700 text-white rounded-full font-semibold shadow hover:bg-blue-800 transition"
          >
            Solicitar combo
          </a>
        </div>
      </div>
    </section>
  </main>
  <script>
    // Animación de aparición con scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate-fade-in-up");
        }
      });
    },
    { threshold: 0.2 });
    document
      .querySelectorAll(".fade-in-up")
      .forEach((el) => observer.observe(el));
  </script>
  <style>
    .fade-in-up {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.8s cubic-bezier(.4, 0, .2, 1),
        transform 0.8s cubic-bezier(.4, 0, .2, 1);
    }
    .animate-fade-in-up {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }
  </style>
</Layout>
