---
import { getImage } from "astro:assets";
---

<nav class="navbar-main  w-full z-50">
  <div class="container  px-8 py-1 flex  justify-evenly">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/img/logo2.png"
        class="w-32 h-16"
        alt="Laboratorio Clinico logo"
      />
    </a>
    <div class="hidden md:flex gap-10 items-center">
      <a href="/" class="nav-link">Inicio</a>
      <a href="/quienes_somos/" class="nav-link">Quiénes somos</a>
      <a href="/combos/" class="nav-link">Combos</a>
      <a href="/contacto/" class="nav-link">Contacto</a>
    </div>
    <button id="menu-toggle" class="md:hidden focus:outline-none">
      <svg
        class="w-7 h-7 text-blue-700 dark:text-blue-200"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>
  </div>
  <div
    id="mobile-menu"
    class="fixed top-0 left-0 w-full h-screen bg-white dark:bg-gray-900 bg-opacity-95 flex flex-col items-center justify-center gap-8 z-40 hidden transition-colors duration-300"
  >
    <a href="/" class="nav-link text-2xl">Inicio</a>
    <a href="/quienes_somos/" class="nav-link text-2xl">Quiénes somos</a>
    <a href="/combos/" class="nav-link text-2xl">Combos</a>
    <a href="/contacto/" class="nav-link text-2xl">Contacto</a>
    <button id="close-menu" class="mt-10 text-blue-700 dark:text-blue-200 text-lg">Cerrar</button>
  </div>
</nav>

<script>
const menuToggle = document.getElementById('menu-toggle');
const mobileMenu = document.getElementById('mobile-menu');
const closeMenu = document.getElementById('close-menu');
menuToggle.onclick = () => mobileMenu.classList.toggle('hidden');
if (closeMenu) closeMenu.onclick = () => mobileMenu.classList.add('hidden');
</script>

<style>
.navbar-main {
  position: sticky;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 9999;

  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  box-shadow: 0 2px 16px rgba(0,0,0,0.08);

  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  will-change: transform;
}
.dark .navbar-main {
  background: rgba(30,41,59,0.85);
  box-shadow: 0 2px 16px rgba(0,0,0,0.18);
}
.nav-link {
  position: relative;
  font-weight: 500;
  color: #2563eb;
  padding: 0.5rem 0.75rem;
  transition: color 0.2s;
}
.dark .nav-link {
  color: #93c5fd;
}
.nav-link:hover {
  color: #1e40af;
}
.dark .nav-link:hover {
  color: #60a5fa;
}
.nav-link::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 2px;
  background: #2563eb;
  transform: scaleX(0);
  transition: transform 0.3s;
}
.dark .nav-link::after {
  background: #60a5fa;
}
.nav-link:hover::after {
  transform: scaleX(1);
}
</style>
